# Cairn server config. Copy to .env and edit — `cp .env.example .env`.
#
# EVERYTHING HERE IS OPTIONAL. With no .env at all, Cairn runs against a local
# Ollama and the database below. Add only the lines you need.

# ---------------------------------------------------------------------------
# 1. The LLM that writes answers  (pick ONE — or none, and Ollama is used)
# ---------------------------------------------------------------------------
# Resolution order, first usable one wins:
#   1. whatever you saved on the Settings screen
#   2. LLM_PROVIDER below
#   3. any single key below that is filled in
#   4. Ollama on this machine
#
# So: paste one key here and it is picked up with no further configuration.

# Force a provider regardless of which keys are present.
# One of: claude | ollama | groq | deepseek | openrouter | gemini | custom
LLM_PROVIDER=

# Fill in at most one of these. Each is the key for its own provider.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Override the model for whichever provider won. Defaults per provider:
#   claude=claude-opus-5   groq=openai/gpt-oss-120b   deepseek=deepseek-chat
#   gemini=gemini-2.0-flash   ollama=the best chat model you have pulled
LLM_MODEL=

# LLM_PROVIDER=custom needs both of these — any OpenAI-compatible server
# (vLLM, LM Studio, LiteLLM, a company gateway). LLM_BASE must be the base
# that has /chat/completions under it.
LLM_BASE=
LLM_API_KEY=

# Where Ollama listens. Used for local answers AND for retrieval embeddings,
# which always run locally and never need a key.
#   ollama pull nomic-embed-text   # embeddings (required for vector recall)
#   ollama pull llama3.1:8b        # answers
OLLAMA_BASE=http://localhost:11434

# ---------------------------------------------------------------------------
# 2. Database
# ---------------------------------------------------------------------------
# Default matches the `db` service in docker-compose.yml, which publishes on
# host port 5434. `docker compose up -d db` and this
# needs no change. Set POSTGRES_PORT too if 5434 is taken on your machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ai_brain

# ---------------------------------------------------------------------------
# 3. Server
# ---------------------------------------------------------------------------
PORT=8300

# dev = no auth, localhost only. google = verify Google ID tokens server-side
# (needs GOOGLE_CLIENT_ID below). Leave as dev when running on your own machine.
AUTH_MODE=dev
# Only for AUTH_MODE=google: restrict sign-in to one Workspace domain.
# Empty = any verified Google account matching the client id.
ALLOWED_DOMAIN=

# Signs Cairn's own short-lived session JWTs. Change it if you expose the port.
SESSION_SECRET=change-me
# Bearer token guarding POST /internal/sync (the CI webhook accelerator).
SYNC_TOKEN=change-me

# Comma-separated wiki roots to sync + index, if you already have wiki folders
# in other repos. Leave empty and Cairn builds its own under wikis/.
WIKI_ROOTS=

# Shows the Pipeline screen: paid, hours-long runs with live logs. Not for
# everyday use. Set to 1 to reveal.
DEV_UI=

# ---------------------------------------------------------------------------
# 4. Connectors — see CONNECTORS.md for the click-by-click setup
# ---------------------------------------------------------------------------
# GET /api/connectors/preflight tells you exactly what is still missing here.

# --- Google Drive + Google Chat (one OAuth client covers both) -------------
# Create a Web application OAuth client in Google Cloud, enable the Drive API
# and the Google Chat API, and register this redirect URI byte for byte:
#   http://localhost:8300/api/google/callback
# Then press Connect in the UI and give consent. Read-only scopes throughout.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Which Drive files to pull. Empty = files you own (the sane default; without
# any ID, "everything ever shared with me" is unbounded on a Workspace domain).
# Each ID may be a folder (walked) or a single file — the string after
# /folders/ or /d/ in the URL.
GDRIVE_SOURCE_IDS=
# Comma-separated glob patterns to skip, matched on the Drive path.
GDRIVE_EXCLUDE=
# Which repo working tree receives sources/ + raw/inbox/ writes.
# Empty = this repo, which is the right answer for a single-machine install.
GDRIVE_TARGET_REPO=

# --- GitHub repos ----------------------------------------------------------
# Public repos need nothing. A private repo needs a fine-grained PAT with
# Contents: read-only; it is embedded in the clone URL and nowhere else, and is
# redacted from every error surface.
GITHUB_TOKEN=
# Clones are disposable (they live under var/). WIKIS ARE NOT: they are the
# artifact, and losing one means paying for every article again.
REPO_CLONE_DIR=
REPO_WIKI_DIR=
# Guardrails: repos tracked, per-repo clone cap (MB), total clone budget (MB).
REPO_MAX_TRACKED=20
REPO_MAX_SIZE_MB=2000
REPO_DISK_BUDGET_MB=5000
# Working trees on this machine that may be cloned from. A path arriving from a
# browser is arbitrary filesystem read, so it must sit inside one of these.
# Empty = the folder containing this repo.
REPO_LOCAL_ROOTS=

# --- Links -----------------------------------------------------------------
# No credentials. Follows URLs found inside other connectors' content.
# Total fetch ATTEMPTS per run (successes + failures) — a run-time valve, not a
# content filter.
LINKS_FETCH_CAP=5000
# Optional headless-browser fallback for pages plain HTTP cannot read. Needs
# Steel (below). Off by default so an install without Steel behaves the same.
STEEL_ENABLED=
LINK_BROWSER_MAX=200
LINK_BROWSER_TIMEOUT=45

# --- WhatsApp / LinkedIn (via Steel Browser) -------------------------------
# These drive a real logged-in browser session. Start Steel first:
#   docker compose up -d steel-api
# BASE/WS are how this process reaches Steel; VIEWER is what YOUR browser
# loads in the login iframe, so it is always the host-visible address.
STEEL_BASE_URL=http://127.0.0.1:3000
STEEL_WS_URL=ws://127.0.0.1:3000
STEEL_VIEWER_BASE_URL=http://localhost:3000

# Comma-separated EXACT chat titles as shown in WhatsApp Web's sidebar. Copy
# them from the live sidebar — a near-miss title silently captures nothing.
WHATSAPP_GROUPS=
# Only messages on/after this date (YYYY-MM-DD). Empty = last 7 days.
WHATSAPP_SINCE=
# WhatsApp renders dates in the account's locale: DMY (31/12/2026) or MDY.
WHATSAPP_DATE_ORDER=DMY

# Comma-separated thread URLs (https://www.linkedin.com/messaging/thread/<id>/).
LINKEDIN_THREADS=
LINKEDIN_SINCE=

# The live-browser iframe shows a logged-in WhatsApp/LinkedIn session, so the
# panel asks for this before rendering it. Empty = fails closed, nobody can
# reveal the iframe. No default here on purpose: nothing sensitive is committed.
BROWSER_VIEW_PASSWORD=

# LLM used ONLY for browser navigation fallback. Extraction is deterministic
# CDP and never touches an LLM.
BROWSER_LLM_MODEL=openai/gpt-oss-120b

# >0 runs the browser connectors every N minutes. 0 = manual "Sync now" only.
CONNECTOR_SYNC_INTERVAL_MIN=0

# ---------------------------------------------------------------------------
# 5. Article generation (the paid step)
# ---------------------------------------------------------------------------
# Absorb turns scraped sources into cited wiki articles — one call per
# source-day, so it is bulk work and usually wants a cheaper model than chat.
# Falls back to the section-1 provider when unset.
ABSORB_BASE=
ABSORB_API_KEY=
ABSORB_MODEL=

# Binaries the pipeline shells out to. Defaults suit a dev machine with a venv
# and `uv tool install graphifyy`; a container image sets its own paths.
PYTHON_BIN=
GRAPHIFY_BIN=
PIPELINE_DIR=

# ---------------------------------------------------------------------------
# 6. Optional S3 backing for the wiki tree
# ---------------------------------------------------------------------------
# Unset = no-op; the filesystem and git remain the store. S3_PREFIX separates
# environments inside one bucket so a single policy covers them all.
S3_BUCKET=
S3_PREFIX=
AWS_REGION=
S3_ENDPOINT=
# Feeder-fetched content (Drive docs, transcripts). Durable and NOT derivable:
# re-fetching gives what a document says today, not what was ingested, so a
# lost source silently invalidates every citation made against it.
SOURCES_DIR=
