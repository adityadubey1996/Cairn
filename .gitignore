# Secrets — provider API keys, SYNC_TOKEN, SESSION_SECRET, DATABASE_URL live here.
.env
.env.local-backup

# Runtime state: corpus indexes and sync manifests. Git is the only storage of
# knowledge; everything under var/ is a disposable cache.
var/

.venv/
__pycache__/
*.pyc
node_modules/
web2/dist/

# OAuth refresh tokens and browser session state (see CONNECTORS.md).
secrets/

# Wiki pipeline scratch: entries/queue are derived and disposable, regenerated
# by ingest.
raw/

# A running personal KB writes private source material and generated knowledge
# here when no external data directory is configured. Keep it out of the code
# repository by default. Deployments must back it up separately; users who
# deliberately version a knowledge tree can force-add it in their private repo.
sources/
wiki/
wikis/*
!wikis/README.md

# macOS noise.
.DS_Store

# graphify knowledge-graph output: regenerate locally with `graphify update .`
graphify-out/

# SDD/worktree scratch — never committed, never shared across branches
.worktrees/

# Brainstorming visual-companion scratch (mockups shown in-browser during design)
.superpowers/

# Local scratch docs stay out; the connector roadmap ships with the repo.
# (Contents, not the directory: git cannot re-include a file whose parent
# directory is excluded.)
docs/*
!docs/plans/
docs/plans/*
!docs/plans/connector-program.md
PRODUCT.md
DESIGN.md
# Local editor/agent config.
.claude/
